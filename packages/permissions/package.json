{
  "name": "@elogbook/permissions",
  "version": "0.0.1",
  "description": "Who may do what with a logbook, defined once (CASL) and used by the Angular app and the API.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:ci": "vitest run",
    "lint": "oxlint --type-aware src/",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.9",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
