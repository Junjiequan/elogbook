# Copy to .env and adjust. Every value has a development default except JWT_SECRET.

# --- server ---
PORT=3000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:4300,http://localhost:4200
# Set to the number of reverse proxies in front of the API (so rate limits see the real client IP).
# TRUST_PROXY=1
# Largest request body in MB (entries may embed images).
MAX_BODY_SIZE_MB=25
SWAGGER_ENABLED=true

# --- database (PostgreSQL) ---
DATABASE_URL=postgres://elogbook:elogbook@localhost:5433/elogbook
# Run pending migrations when the API starts. Turn off if your deployment runs them separately.
DATABASE_MIGRATE=true

# --- authentication ---
# Secret that signs access tokens: at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=
# Token lifetime in seconds (default 8 hours).
JWT_EXPIRES_IN=28800
# Let people create an account with POST /auth/register. Turn off once an identity provider is in place.
AUTH_ALLOW_REGISTRATION=true
# Comma-separated emails that get the "admin" role (may delete any logbook they can open).
ADMIN_EMAILS=anna.lindqvist@example.org

# --- rate limits (requests per minute per client) ---
RATE_LIMIT=120
AUTH_RATE_LIMIT=10
