PORT=3000
CORS_ORIGINS=http://localhost:4300,http://localhost:4200
MAX_BODY_SIZE_MB=25
SWAGGER_ENABLED=true

DATABASE_URL=postgres://elogbook:elogbook@localhost:5433/elogbook
DATABASE_MIGRATE=true

# At least 32 characters: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=28800
AUTH_ALLOW_REGISTRATION=true
ADMIN_EMAILS=anna.lindqvist@example.org

OAUTH_ISSUER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_LABEL=Google
OAUTH_REDIRECT_URI=http://localhost:4300/api/v1/auth/oauth/callback
OAUTH_FRONTEND_URL=http://localhost:4300
OAUTH_ALLOWED_EMAIL_DOMAINS=
OAUTH_CREATE_ACCOUNTS=true

ENABLE_DEMO=false

RATE_LIMIT=120
AUTH_RATE_LIMIT=10
