{
  "name": "elogbook",
  "version": "0.0.0",
  "private": true,
  "description": "Electronic logbook: Angular frontend and NestJS backend.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "frontend",
    "backend"
  ],
  "scripts": {
    "prepare": "npm run build -w @elogbook/permissions",
    "build:packages": "npm run build -w @elogbook/permissions",
    "start": "npm run start -w frontend",
    "start:frontend": "npm run start -w frontend",
    "start:backend": "npm run start:dev -w backend",
    "dev": "concurrently -n frontend,backend -c cyan,green \"npm:start:frontend\" \"npm:start:backend\"",
    "db:up": "docker compose -f backend/docker-compose.yaml up -d db",
    "db:down": "docker compose -f backend/docker-compose.yaml down",
    "build": "npm run build --workspaces --if-present",
    "build:pages": "npm run build:pages -w frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:ci --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w backend",
    "format:check": "npm run format:check --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
